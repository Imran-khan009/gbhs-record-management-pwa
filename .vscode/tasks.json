{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto Start Project",
      "type": "shell",
      "command": "if (Get-Command bun -ErrorAction SilentlyContinue) { bun run dev } else { & \"$env:USERPROFILE\\.bun\\bin\\bun.exe\" run dev }",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*",
          "endsPattern": ".*Local:.*"
        }
      }
    }
  ]
}
